# Existing identity remains application-owned.
OTEL_ENABLED=True
OTEL_SERVICE_NAME=react-pattern-archetype-mgr
AGENT_NAME=react-pattern-archetype
OTEL_INSTRUMENT_FASTAPI=True
OTEL_INSTRUMENT_HTTPX=True
OTEL_INSTRUMENT_PYMONGO=True
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=Delta
TRACELOOP_TELEMETRY=false
TRACELOOP_TRACE_CONTENT=true

# The only observability destination the archetype/user needs to know.
OTEL_EXPORTER_OTLP_ENDPOINT=https://<central-collector>:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=

# Do not expose DT_*, ARIZE_*, PHOENIX_* or Agent365 exporter credentials here.
