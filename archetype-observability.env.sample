# ============================================================
# VARIABLES QUE DEBEN QUEDAR EN EL ARQUETIPO
# ============================================================
OTEL_ENABLED=True
OTEL_SERVICE_NAME=react-pattern-archetype-mgr
AGENT_NAME=react-pattern-archetype

OTEL_INSTRUMENT_FASTAPI=True
OTEL_INSTRUMENT_HTTPX=True
OTEL_INSTRUMENT_PYMONGO=True
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=Delta

# Único destino de observabilidad conocido por el usuario del arquetipo.
OTEL_COLLECTOR_ENDPOINT=https://<central-collector>:4318
OTEL_EXPORTER_OTLP_ENDPOINT=https://<central-collector>:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
TRACELOOP_BASE_URL=https://<central-collector>:4318
TRACELOOP_HEADERS=
TRACELOOP_TELEMETRY=false
TRACELOOP_TRACE_CONTENT=true

# NO deben estar en el arquetipo:
# DT_TENANT / DT_CONNECTION_POINT / DT_TENANT_TOKEN / DT_OTLP_ENDPOINT / DT_API_TOKEN
# PHOENIX_* / ARIZE_*
# AGENT365_* de autenticación/exportación
