# ============================================================
# COLLECTOR CENTRAL - SOLO CUENTA DE OBSERVABILIDAD
# Estas variables NO deben existir en el arquetipo consumidor.
# ============================================================
AWS_REGION=eu-west-1
ARIZE_ALLOWLIST_TABLE=otel-arize-enabled-agents
ARIZE_ALLOWLIST_REFRESH_SECONDS=15
BACKEND_CONFIG=/etc/otelcol-contrib/backend-policy-defaults.yaml
ARIZE_ROUTING_RESOURCE_ATTRIBUTE=service.name

# Dynatrace (backend preparado; flag por defecto=true)
DT_OTLP_ENDPOINT=https://<tenant>.live.dynatrace.com/api/v2/otlp
DT_API_TOKEN=*********************************
DT_TLS_INSECURE_SKIP_VERIFY=false

# Arize AX (pipeline preparado; enabled=true, pero la tabla vacía => ningún agente se exporta)
ARIZE_OTLP_ENDPOINT=https://otlp.arize.com
ARIZE_API_KEY=*********************************
ARIZE_SPACE_ID=*********************************
ARIZE_PROJECT_NAME=central-agent-platform

# Microsoft Agent 365 (backend preparado; flag ACTUAL por defecto=false)
# IMPORTANTE: el endpoint de Agent 365 contiene AGENT365_AGENT_ID. Esta
# configuración sirve para una integración/agent target. Antes de activar
# Agent365 para múltiples arquetipos hay que resolver el routing por Agent ID.
AGENT365_TENANT_ID=
AGENT365_AGENT_ID=
AGENT365_CLIENT_SECRET=
